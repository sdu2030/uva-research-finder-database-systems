# ================================
# Git / Version Control
# ================================
.git
.gitignore

# ================================
# macOS Junk
# ================================
.DS_Store
.AppleDouble
.LSOverride

# ================================
# Windows Junk
# ================================
Thumbs.db
desktop.ini

# ================================
# VS Code / JetBrains
# ================================
.vscode/
.idea/
*.iml
vcs.xml
modules.xml
php.xml

# ================================
# Node / NPM (if ever present)
# ================================
node_modules/
npm-debug.log*
yarn-error.log*

# ================================
# Python / Virtual Envs (just in case)
# ================================
__pycache__/
*.pyc
env/
venv/

# ================================
# Local secrets & env files
# ================================
.env
.env.local

# ================================
# OS / Temp / Backup Files
# ================================
*.log
*.tmp
*.swp
*.bak
*.old
*~

# ================================
# ZIPs & large uploads (you uploaded many earlier)
# ================================
*.zip
*.tgz
*.tar.gz

# ================================
# What MUST stay included
# ================================
!app.yaml
!index.php
!login.php
!student.php
!professor.php
!connect-db.php
!project_details.php
!projects.php
!project-db.php
!prof-db.php
!person-db.php
!login-db.php
!create_project.php
!update_project.php
!request-db.php
!header.php
!footer.php
!assets/
